<mujoco model="falling_box">
  <option gravity="0 0 -9.81" timestep="0.002"/>
  <asset>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>
  </asset>
  <worldbody>
    <light pos="0 0 4" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="5 5 0.1" material="groundplane"/>
    <body name="box" pos="0 0 1.1">
      <freejoint name="box_joint"/>
      <!-- 1kg cubic box, half-size 0.1m (20cm side), bottom face starts at z=1m above floor -->
      <geom name="box_geom" type="box" size="0.1 0.1 0.1" mass="1" rgba="0.2 0.6 0.8 1"/>
    </body>
  </worldbody>
</mujoco>
