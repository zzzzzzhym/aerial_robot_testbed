<mujoco model="inclined_box">
  <option gravity="0 0 -9.81" timestep="0.002"/>
  <asset>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>
  </asset>
  <worldbody>
    <light pos="0 0 4" dir="0 0 -1" directional="true"/>
    <!-- 50deg inclination: tan(50deg)~1.19 > mu=1, box slides -->
    <geom name="inclined_floor" type="plane" size="5 5 0.1" euler="0 50 0"
          material="groundplane" friction="1 0.005 0.0001"/>
    <!-- box center placed on slope surface, 1m up from origin, aligned with floor -->
    <body name="box" pos="-0.57 0 0.83" euler="0 50 0">
      <freejoint name="box_joint"/>
      <geom name="box_geom" type="box" size="0.1 0.1 0.1" mass="1" rgba="0.9 0.4 0.2 1"
            friction="1 0.005 0.0001"/>
    </body>
  </worldbody>
</mujoco>
